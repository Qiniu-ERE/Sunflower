{
  "description": "树莓派 4B 演示：USB 会议麦 + HDMI 屏 + UxPlay；Mac 跑编程代理",
  "device": {
    "mac": "02:CC:72:00:00:01",
    "audio_in": [
      "arecord",
      "-q",
      "-D",
      "plughw:CARD=default",
      "-f",
      "S16_LE",
      "-r",
      "16000",
      "-c",
      "1",
      "-t",
      "raw"
    ],
    "audio_out": [
      "aplay",
      "-q",
      "-D",
      "plughw:CARD=default",
      "-f",
      "S16_LE",
      "-r",
      "16000",
      "-c",
      "1",
      "-t",
      "raw"
    ],
    "trigger": "evdev",
    "host_url": "http://mac-host.local:8787"
  },
  "host": {
    "bind": "0.0.0.0",
    "port": 8787,
    "agent": "codex",
    "workspace": "~/sunflower-demo",
    "codex_channel": "qiniu-gpt",
    "codex_channels": {
      "qiniu-gpt": [],
      "icodeeasy": [
        "-c",
        "model_providers.icodeeasy.supports_websockets=false"
      ]
    }
  }
}
